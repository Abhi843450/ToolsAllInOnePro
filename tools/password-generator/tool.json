      {
        "name": "uppercase",
        "type": "checkbox",
        "label": "Uppercase (A-Z)",
        "default": true
      },
      {
        "name": "lowercase",
        "type": "checkbox",
        "label": "Lowercase (a-z)",
        "default": true
      },
      {
        "name": "numbers",
        "type": "checkbox",
        "label": "Numbers (0-9)",
        "default": true
      },
      {
        "name": "symbols",
        "type": "checkbox",
        "label": "Symbols (!@#$...)",
        "default": true
      }
    ]
